/* ==========================================================
   SmartHome Light - front-end controller
   ========================================================== */
(function () {
  'use strict';

  const BASE = window.APP_BASE || '';
  const api = (path) => BASE + '/' + path;

  function csrf() {
// The token is printed by render_footer(); fall back to a form field.
    if (window.CSRF_TOKEN) return window.CSRF_TOKEN;
    const el = document.querySelector('input[name="csrf"]');
    return el ? el.value : '';
  }

  async function post(path, data) {
    const body = new FormData();
    body.append('csrf', csrf());
    Object.entries(data || {}).forEach(([k, v]) => body.append(k, v));
    const res = await fetch(api(path), { method: 'POST', body, credentials: 'same-origin' });
    if (res.status === 401 || (res.redirected && res.url.indexOf('login') !== -1)) {
      window.location.href = api('login.php');
      throw new Error('Session expired');
    }
    const json = await res.json().catch(() => ({ ok: false, error: 'Bad response' }));
    if (!json.ok) throw new Error(json.error || 'Request failed');
    return json;
  }

  function sendColor(id, hex) {
    return post('api/light_action.php', {
      device_id: id,
      action: 'color',
      r: parseInt(hex.slice(1, 3), 16),
      g: parseInt(hex.slice(3, 5), 16),
      b: parseInt(hex.slice(5, 7), 16)
    });
  }

  const cards = document.querySelectorAll('.light-card');

  cards.forEach((card) => {
    const id = card.dataset.device;
    const powerBtn = card.querySelector('[data-action="toggle"]');
    const testBtn = card.querySelector('[data-action="test"]');
    const slider = card.querySelector('[data-action="brightness"]');
    const colorInp = card.querySelector('[data-action="color"]');
    const preset = card.querySelector('[data-action="preset"]');

// Test blink - flashes the physical LED without changing stored state
    if (testBtn) {
      testBtn.addEventListener('click', async () => {
        testBtn.disabled = true;
        const old = testBtn.textContent;
        testBtn.textContent = 'Blinking...';
        try {
          await post('api/light_action.php', { device_id: id, action: 'test' });
        } catch (err) { alert('Error: ' + err.message); }
        setTimeout(() => { testBtn.textContent = old; testBtn.disabled = false; }, 4000);
      });
    }

    if (powerBtn) {
      powerBtn.addEventListener('click', async () => {
        powerBtn.disabled = true;
        try {
          await post('api/light_action.php', { device_id: id, action: 'toggle' });
          await refresh();
        } catch (err) { alert('Error: ' + err.message); }
        finally { powerBtn.disabled = false; }
      });
    }

    if (slider) {
      const label = card.querySelector('[data-role="brightness-label"]');
      let timer = null;
      slider.addEventListener('input', () => {
        if (label) label.textContent = slider.value + '%';
      });
      slider.addEventListener('change', () => {
        clearTimeout(timer);
        timer = setTimeout(async () => {
          try {
            await post('api/light_action.php', {
              device_id: id, action: 'brightness', brightness: slider.value
            });
            await refresh();
          } catch (err) { alert('Error: ' + err.message); }
        }, 150);
      });
    }

    if (colorInp) {
      colorInp.addEventListener('change', async () => {
        try {
          await sendColor(id, colorInp.value);
          await refresh();
        } catch (err) { alert('Error: ' + err.message); }
      });
    }

    if (preset) {
      preset.addEventListener('change', async () => {
        const hex = preset.value.split('|')[1];
        if (!hex) return;
        try {
          await sendColor(id, hex);
          preset.selectedIndex = 0;
          await refresh();
        } catch (err) { alert('Error: ' + err.message); }
      });
    }
  });

  function paintCard(card, d) {
    card.classList.toggle('is-on', !!d.is_on);
    card.classList.toggle('is-offline', !d.online);

    const bulb = card.querySelector('.bulb');
    const icon = card.querySelector('.bulb-icon');
    const dim = 0.35 + 0.65 * (d.brightness / 100);

    if (bulb) {
      bulb.style.background = d.is_on
        ? 'rgba(' + d.color_r + ',' + d.color_g + ',' + d.color_b + ',' + dim + ')'
        : 'rgba(120,130,150,.12)';
      bulb.style.boxShadow = d.is_on
        ? '0 0 42px rgba(' + d.color_r + ',' + d.color_g + ',' + d.color_b + ',.55)'
        : 'none';
    }
    if (icon) icon.innerHTML = d.is_on ? '&#128161;' : '&#9788;';

    const setText = (role, text) => {
      const el = card.querySelector('[data-role="' + role + '"]');
      if (el) el.textContent = text;
    };
    setText('state', d.is_on ? 'ON' : 'OFF');
    setText('brightness', d.brightness + '%');
    setText('brightness-label', d.brightness + '%');
    setText('power', Number(d.watts).toFixed(1) + ' W');

    // Tell the user whether the hardware really matches the command.
    const sync = card.querySelector('[data-role="sync"]');
    if (sync) {
      if (!d.online) {
        sync.textContent = 'device offline';
        sync.className = 'sync-note wait';
      } else if (d.in_sync) {
        sync.textContent = 'LED matches the setting';
        sync.className = 'sync-note ok';
      } else {
        sync.textContent = 'waiting for the LED to confirm...';
        sync.className = 'sync-note wait';
      }
    }

    const dot = card.querySelector('.status-dot');
    if (dot) {
      dot.classList.toggle('on', !!d.online);
      dot.classList.toggle('off', !d.online);
      dot.title = d.online ? 'Online' : 'Offline';
    }

    const btn = card.querySelector('[data-action="toggle"]');
    if (btn) {
      btn.textContent = d.is_on ? 'Turn off' : 'Turn on';
      btn.classList.toggle('on', !!d.is_on);
    }

    const sl = card.querySelector('[data-action="brightness"]');
    if (sl && document.activeElement !== sl) sl.value = d.brightness;

    const ci = card.querySelector('[data-action="color"]');
    if (ci && document.activeElement !== ci) {
      const hex = '#' + [d.color_r, d.color_g, d.color_b]
        .map(n => Number(n).toString(16).padStart(2, '0')).join('');
      ci.value = hex;
    }

    const foot = card.querySelector('.light-foot');
    if (foot) {
      const spans = foot.querySelectorAll('span');
      if (spans[0]) spans[0].textContent = d.rssi + ' dBm';
      if (spans[1]) spans[1].textContent = d.ip_address || 'no ip';
    }
  }

  async function refresh() {
    if (!cards.length) return;
    try {
      const res = await fetch(api('api/get_state.php'), { credentials: 'same-origin' });
      if (res.redirected) { window.location.href = api('login.php'); return; }
      const json = await res.json();
      if (!json.ok) return;

      json.devices.forEach(d => {
        const card = document.querySelector('.light-card[data-device="' + d.id + '"]');
        if (card) paintCard(card, d);
      });

      const s1 = document.getElementById('statOn');
      if (s1) s1.textContent = json.summary.lights_on;
      const s2 = document.getElementById('statWatts');
      if (s2) s2.textContent = Number(json.summary.total_watts).toFixed(1);
    } catch (e) { /* keep last known state */ }
  }

  if (cards.length) {
    refresh();
    setInterval(refresh, 4000);
  }

  window.copyKey = function (btn) {
    const key = btn.closest('tr').querySelector('[data-role="key"]').textContent.trim();
    navigator.clipboard.writeText(key).then(
      () => {
        const old = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = old; }, 1500);
      },
      () => alert('Key: ' + key)
    );
  };

  window.delDevice = async function (id, btn) {
    try {
      await post('api/device_action.php', { action: 'delete', device_id: id });
      const row = btn.closest('tr');
      row.style.opacity = '0';
      setTimeout(() => row.remove(), 300);
    } catch (err) { alert('Error: ' + err.message); }
  };

  window.runNow = async function (id, btn) {
    btn.disabled = true;
    try {
      await post('api/schedule_action.php', { action: 'run_now', id });
      btn.textContent = 'Sent';
      setTimeout(() => { btn.textContent = 'Run now'; btn.disabled = false; }, 1500);
    } catch (err) {
      alert('Error: ' + err.message);
      btn.disabled = false;
    }
  };

  const boxes = document.querySelectorAll('.day-box');
  if (boxes.length) {
    const sync = () => {
      let bits = '';
      boxes.forEach(b => { bits += b.checked ? '1' : '0'; });
      const hidden = document.getElementById('daysOfWeek');
      if (hidden) hidden.value = bits;
    };
    boxes.forEach(b => b.addEventListener('change', sync));
    sync();
  }
})();
